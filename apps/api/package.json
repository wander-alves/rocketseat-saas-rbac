{
  "name": "@rbac/api",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run env:load tsx watch ./src/http/server.ts",
    "env:load": "dotenv -e ../../.env --",
    "prisma:generate": "npm run env:load prisma generate",
    "prisma:migrate": " npm run env:load prisma migrate dev",
    "prisma:studio": "npm run env:load prisma studio",
    "prisma:seed": "npm run env:load tsx ./prisma/seed.ts",
    "services:start": "docker compose -f ../../docker-compose.yaml start",
    "services:stop": "docker compose -f ../../docker-compose.yaml stop",
    "services:up": "docker compose -f ../../docker-compose.yaml up -d",
    "services:down": "docker compose -f ../../docker-compose.yaml down"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.2.0",
    "@rbac/auth": "*",
    "@rbac/env": "*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.1.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@rbac/eslint-config": "*",
    "@rbac/prettier": "*",
    "@rbac/tsconfig": "*",
    "@types/node": "^26.6.7",
    "prisma": "7.2.0",
    "tsx": "^4.23.15"
  },
  "prettier": "@rbac/prettier",
  "eslintConfig": {
    "extends": [
      "@rbac/eslint-config/node"
    ]
  }
}
